{
  "name": "packagecare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --import tsx server/index.ts",
    "test": "vitest run",
    "maintenance": "node --import tsx scripts/maintenance.ts",
    "fixtures": "node --import tsx scripts/generate-fixtures.ts",
    "evaluate": "node --import tsx scripts/evaluate.ts",
    "ring:probe": "node --import tsx scripts/ring-probe.ts",
    "infra:synth": "cdk synth --app 'node --import tsx infra/app.ts'"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.0.0",
    "@aws-sdk/client-dynamodb": "^3.0.0",
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/client-sfn": "^3.0.0",
    "@aws-sdk/lib-dynamodb": "^3.0.0",
    "@aws-sdk/s3-presigned-post": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@codegenie/serverless-express": "^5.0.0",
    "@fontsource/dm-sans": "^5.3.0",
    "archiver": "^7.0.0",
    "aws-cdk-lib": "^2.0.0",
    "constructs": "^10.0.0",
    "dotenv": "^16.4.0",
    "express": "^5.0.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "aws-cdk": "^2.0.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
