# Local-only by default. Do not expose localhost development mode to a network.
PORT=3001
HOST=127.0.0.1
DATA_DIR=./data
# Set before deploying/exposing the application. Use a long random password.
PACKAGECARE_PASSWORD=
SESSION_SECRET=
RING_ACCESS_TOKEN=
RING_HMAC_KEY=
RING_ACCOUNT_ID=
# Explicitly choose ring_device or ring_simulator; fixtures are always labeled separately.
RING_SOURCE_TYPE=ring_simulator
AWS_REGION=us-east-2
AWS_PROFILE=pkgcare
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
ANALYSIS_STRATEGY=dense_frames
# Local AWS clients use pkgcare; Lambda uses its execution role.
# Bedrock inference and cloud resources are billed to your AWS account.
# PACKAGECARE_ANALYZER=local uses the bundled handling classifier instead of Bedrock.
# Optional cloud storage + workflow, created by infrastructure deployment:
PACKAGECARE_BUCKET=
PACKAGECARE_TABLE=
PACKAGECARE_STATE_MACHINE=
RETENTION_DAYS=30
